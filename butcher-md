const getMenuMedia = async () => {
    try {
        if (fs.existsSync(MENU_MEDIA_FILE)) {
            return fs.readFileSync(MENU_MEDIA_FILE)
        }
        
        if (config.menuMediaUrl) {
            const response = await axios.get(config.menuMediaUrl, { responseType: 'arraybuffer' })
            return Buffer.from(response.data, 'binary')
        }
        
        const randomId = Math.floor(Math.random() * 1000)
        const url = `https://picsum.photos/300/400?random=${randomId}`
        const response = await axios.get(url, { responseType: 'arraybuffer' })
        return Buffer.from(response.data, 'binary')
    } catch (e) {
        console.error('Error fetching media:', e)
        return null
    }
}

